<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Python's eval/JIT loop (D-13) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for bundled third-party .dylib files from librosa/numpy/soundfile (D-13) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- No app sandbox — arbitrary file system access needed for user's music library (D-13) -->
    <!-- Sandbox entitlement is intentionally absent -->
</dict>
</plist>
